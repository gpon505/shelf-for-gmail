{
  "manifest_version": 3,
  "name": "Shelf \u2014 sections & notes for Gmail",
  "short_name": "Shelf",
  "version": "1.8.3",
  "key": "",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "description": "Group Gmail threads under your own section headers. Add sticky notes & colors. No account, no server \u2014 nothing leaves your browser.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "shelf.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
